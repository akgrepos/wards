{
  "name": "wards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-precache.mjs",
    "check:offline": "node scripts/check-precache.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "pwa-assets-generator",
    "content:check": "node scripts/content/cli.mjs",
    "content:uses": "node scripts/content/uses.mjs",
    "content:diff": "node scripts/content/compose-diff.mjs",
    "checked:stamp": "node scripts/content/checked.mjs stamp",
    "checked:carry": "node scripts/content/checked.mjs carry",
    "pr:tier": "node scripts/content/tier.mjs",
    "privacy:check": "node scripts/privacy-check.mjs",
    "changelog": "node scripts/changelog.mjs",
    "card:new": "node scripts/card-new.mjs",
    "brief": "node scripts/brief.mjs",
    "sources:due": "node scripts/sources-due.mjs",
    "look": "node scripts/look.mjs",
    "sim-look": "node scripts/sim-look.mjs",
    "tidy": "node scripts/tidy.mjs",
    "review:precheck": "node scripts/review-precheck.mjs",
    "card:proof": "node scripts/card/format-proof.mjs",
    "page-shots": "node scripts/page-shots.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
